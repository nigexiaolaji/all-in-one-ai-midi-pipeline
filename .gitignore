# Python
__pycache__/
*.py[cod]

# Virtual envs
.venv/
.venv-ai-midi/

# macOS
.DS_Store

# Logs / temp
*.log
*.tmp

# --- Pipeline outputs: keep dirs, ignore contents ---
out_midis/*
!out_midis/.gitkeep

# --- Manifests (runtime-generated, don't commit) ---
manifests/*.json
!manifests/.gitkeep

# --- Data directories (keep structure, ignore contents) ---
data/raw/*
data/stems/*
data/midi/*
!data/raw/.gitkeep
!data/stems/.gitkeep
!data/midi/.gitkeep

# --- Auto-run generated dirs ---
input/
output/

# --- Audio (don't commit) ---
*.wav
*.aiff
*.aif
*.flac
*.mp3

# --- MIDI (don't commit) ---
*.mid

# --- Model files (too large) ---
model/
*.pth
*.bin
*.safetensors
*.ckpt

# --- Accidental backup files ---
.gitignore.save
*~
*.bak